# Apunta al gateway (gr-api-gateway), no a gr-user-microservice directo: es
# el unico origen que expone tanto auth como el muro (/api/v1/publicaciones).
BACKEND_API_URL=http://localhost:4000

# Host publico de cada aplicacion de rol, a donde entrega el puente SSO tras
# el login. RESIDENTE y VIGILANTE aterrizan hoy en gr-common-ui porque
# gr-residente-ui y gr-vigilante-ui todavia no existen como repositorios
# propios.
NEXT_PUBLIC_ADMIN_UI_URL=http://localhost:3001
NEXT_PUBLIC_COMMON_UI_URL=http://localhost:3000
